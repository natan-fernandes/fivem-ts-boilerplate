# Database Configuration for FiveM
# PostgreSQL is the recommended database for FiveM servers

# Database URL for PostgreSQL (Recommended)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://postgres:password@localhost:5432/fivem_database"

# Alternative configuration using individual variables (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=fivem_database


# Connection pool settings (optional)
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000

# MySQL Alternative (if you prefer MySQL over PostgreSQL)
# Uncomment and use these settings if you switch to MySQL:
# DATABASE_URL="mysql://root:password@localhost:3306/fivem_database"
# DB_CHARSET=utf8mb4
# DB_COLLATE=utf8mb4_unicode_ci
